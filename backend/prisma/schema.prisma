// RESET database schema.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254) // stored lowercase
  passwordHash String   @db.VarChar(100)
  timeZone     String   @default("UTC") @db.VarChar(64) // IANA name, e.g. "Asia/Tashkent"
  climber      String   @default("boy") @db.VarChar(8) // who climbs the hill: "boy" or "girl"
  accent       String   @default("purple") @db.VarChar(10) // the app colour, e.g. "blue"
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  habits   Habit[]
  sessions Session[]
  climbs   Climb[]
}

/// A climb up the journey hill: the user picks how long it is, then each day they
/// complete habits moves them up. When one is finished they can start the next.
model Climb {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  goalDays   Int // 30, 66, 100 or 365
  startDate  DateTime  @db.Date // the first day that counts (user's local date)
  finishedOn DateTime? @db.Date // set when the user moves on to the next climb
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Habit {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  emoji       String?  @db.VarChar(32) // one emoji chosen by the user, e.g. "💧"; null = none
  startDate   DateTime @db.Date // user's local calendar date when the habit was created
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions HabitCompletion[]
  pauses      HabitPause[]

  @@index([userId, isArchived])
}

/// A time a habit was archived. The journey leaves the habit out of the days
/// between archivedOn and restoredOn (both of those days still count).
model HabitPause {
  id         String    @id @default(uuid()) @db.Uuid
  habitId    String    @db.Uuid
  archivedOn DateTime  @db.Date // the last day the habit still counts (user's local date)
  restoredOn DateTime? @db.Date // the first day it counts again; null = still archived

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([habitId])
}

model HabitCompletion {
  id        String   @id @default(uuid()) @db.Uuid
  habitId   String   @db.Uuid
  date      DateTime @db.Date // calendar date only, no time
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date]) // at most one completion per habit per day
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3) // set on logout

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
