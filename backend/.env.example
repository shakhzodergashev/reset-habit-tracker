# Copy this file to .env and replace the placeholder values.
# Never commit .env. It contains real credentials.

# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://reset_app:CHANGE_ME@localhost:5432/reset_dev?schema=public"

# Secret used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="CHANGE_ME"
